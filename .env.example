# Copy to .env.local and fill with real values from the Supabase dashboard.

# Browser-safe (anon key + URL) — exposed to the client bundle by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side ONLY. Bypasses every RLS policy — never put in a NEXT_PUBLIC_ var or the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Supabase CLI / migrations).
# SUPABASE_DB_PASSWORD=your-database-password

# SMTP — used to email user invites (§7 screen 6). Server-side only. If unset, the invite
# screen shows a copyable link instead of sending mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=you@example.com
