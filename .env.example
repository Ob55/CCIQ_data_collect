# Copy to .env.local and fill with real values from the Supabase dashboard.

# --- Frontend (Vite SPA) ---
# Browser-safe (anon key + URL) — exposed to the client bundle by design. Vite only exposes
# vars prefixed with VITE_. RLS governs every table, so the anon key is safe in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase CLI (migrations) ---
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_ACCESS_TOKEN=your-access-token

# --- Edge Function secrets (set via `supabase secrets set`, NOT in the client) ---
# The service role bypasses every RLS policy — it lives ONLY in the admin-users Edge Function.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SMTP — used by the admin-users function to email user invites. If unset, the invite screen
# shows a copyable link instead of sending mail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=you@example.com
